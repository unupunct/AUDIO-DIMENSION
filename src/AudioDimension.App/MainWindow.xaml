<Window x:Class="AudioDimension.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AudioDimension.App.ViewModels"
        xmlns:v="clr-namespace:AudioDimension.App.Views"
        Title="{Binding WindowTitle}" Width="1360" Height="840" MinWidth="980" MinHeight="620"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding Projects.NewProjectCommand}"/>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding Projects.OpenProjectCommand}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding Projects.SaveCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding Projects.SaveAsCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AudioViewModel}"><v:AudioView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StudioViewModel}"><v:StudioView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PresetLibraryViewModel}"><v:PresetLibraryView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TextEditorViewModel}"><v:TextEditorView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecordingViewModel}"><v:RecordingView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectsViewModel}"><v:ProjectsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TextInspector}"><v:TextInspectorView DataContext="{Binding Editor}"/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StudioInspector}"><v:StudioInspectorView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}"><v:AboutView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PendingPageViewModel}"><v:PendingView/></DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}"/>
        </Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12">
                <StackPanel DockPanel.Dock="Top" Margin="6,8,0,20">
                    <TextBlock Text="AUDIO" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                    <TextBlock Text="Dimension" Style="{StaticResource H1}" FontSize="22"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Pages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource NavButton}" GroupName="nav" AutomationProperties.Name="{Binding Title}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="24,14,16,0">
                <Button DockPanel.Dock="Right" Command="{Binding ToggleInspectorCommand}" ToolTip="Show / hide inspector" Padding="10,6">
                    <TextBlock Text="&#xE8A0;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                <TextBlock Text="{Binding SelectedPage.Title}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                <Border CornerRadius="10" Padding="10,4" Margin="12,0,0,0" Background="#55C62828" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding RecVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#FF5252" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding RecText}" FontSize="11" FontWeight="Bold" Margin="7,0,0,0" Foreground="#FF8A8A" AutomationProperties.Name="Recording indicator"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="10" Padding="10,4" Margin="16,0,0,0" Background="#33F0616D" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding CaptureLive}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CaptureText}" FontSize="11" FontWeight="SemiBold" Margin="7,0,0,0" Foreground="{StaticResource DangerBrush}"/>
                    </StackPanel>
                </Border>
            </DockPanel>
            <!-- Pages are created once and toggled by visibility (see MainWindow.xaml.cs) so GL contexts and UI state survive navigation -->
            <Grid x:Name="PageHost" Grid.Row="1" Margin="24,8,16,16"/>
        </Grid>

        <Border Grid.Column="2" Width="280" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding InspectorVisible}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="18,18,8,0">
                <ContentControl Content="{Binding SelectedPage.InspectorViewModel}"/>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPage.InspectorViewModel}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Inspector" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}"
                               Text="Open Visualizer Studio to adjust animation, colours, camera, background and effects for the live preview."/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
