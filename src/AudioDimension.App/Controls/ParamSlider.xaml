<UserControl x:Class="AudioDimension.App.Controls.ParamSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root">
    <StackPanel Margin="0,0,0,10">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="{Binding Value, ElementName=root, StringFormat={}{0:0.00}}"/>
                <TextBlock Text="{Binding Unit, ElementName=root}" Style="{StaticResource Muted}" Margin="3,0,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding Label, ElementName=root}" Style="{StaticResource Muted}"/>
        </DockPanel>
        <Slider Minimum="{Binding Minimum, ElementName=root}" Maximum="{Binding Maximum, ElementName=root}"
                Value="{Binding Value, ElementName=root, Mode=TwoWay}" Margin="0,4,0,0"/>
    </StackPanel>
</UserControl>
