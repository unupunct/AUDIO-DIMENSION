<UserControl x:Class="AudioDimension.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="Margin" Value="0,10,0,4"/></Style>
    </UserControl.Resources>
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Settings" Style="{StaticResource H1}"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Save" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}" Width="100"/>
            <Button Content="Reset to defaults" Command="{Binding ResetCommand}" Margin="8,0,0,0"/>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="14,0,0,0" Style="{StaticResource Muted}"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,12,0">
                <TextBlock Text="Audio" Style="{StaticResource H2}"/>
                <Border Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Text="Sample rate (Hz)" Style="{StaticResource Lbl}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding SampleRates}" SelectedItem="{Binding Draft.SampleRate}"/>
                    <TextBlock Text="Capture buffer (ms)" Style="{StaticResource Lbl}"/>
                    <Slider Minimum="5" Maximum="100" Value="{Binding Draft.BufferMilliseconds}"/>
                    <TextBlock Text="Default sensitivity" Style="{StaticResource Lbl}"/>
                    <Slider Minimum="0.1" Maximum="4" Value="{Binding Draft.Sensitivity}"/>
                    <TextBlock Text="Audio smoothing" Style="{StaticResource Lbl}"/>
                    <Slider Minimum="0" Maximum="0.95" Value="{Binding Draft.AudioSmoothing}"/>
                    <TextBlock Text="Default input and system devices are chosen on the Audio page (Stage 2)." Style="{StaticResource Muted}" Margin="0,10,0,0" FontSize="12"/>
                </StackPanel></Border>

                <TextBlock Text="Rendering" Style="{StaticResource H2}"/>
                <Border Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Text="Graphics quality" Style="{StaticResource Lbl}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding Draft.GraphicsQuality}"/>
                    <TextBlock Text="Effects quality" Style="{StaticResource Lbl}"/>
                    <ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding Draft.EffectsQuality}"/>
                    <TextBlock Text="Target frame rate" Style="{StaticResource Lbl}"/>
                    <ComboBox ItemsSource="{Binding FrameRates}" SelectedItem="{Binding Draft.TargetFrameRate}"/>
                    <TextBlock Text="Anti-aliasing samples" Style="{StaticResource Lbl}"/>
                    <ComboBox ItemsSource="{Binding AaLevels}" SelectedItem="{Binding Draft.AntiAliasingSamples}"/>
                    <TextBlock Text="Particle limit" Style="{StaticResource Lbl}"/>
                    <Slider Minimum="1000" Maximum="100000" Value="{Binding Draft.ParticleLimit}"/>
                    <CheckBox Content="VSync" IsChecked="{Binding Draft.VSync}" Margin="0,10,0,0"/>
                    <CheckBox Content="Lightweight mode (for low-end graphics)" IsChecked="{Binding Draft.LightweightMode}"/>
                </StackPanel></Border>

                <TextBlock Text="Recording" Style="{StaticResource H2}"/>
                <Border Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Text="Default format" Style="{StaticResource Lbl}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Draft.DefaultFormat}"/>
                    <TextBlock Text="Default resolution" Style="{StaticResource Lbl}"/>
                    <ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding Draft.DefaultResolution}"/>
                    <TextBlock Text="Default frame rate" Style="{StaticResource Lbl}"/>
                    <ComboBox ItemsSource="{Binding FrameRates}" SelectedItem="{Binding Draft.DefaultFrameRate}"/>
                    <TextBlock Text="Video quality (1-100)" Style="{StaticResource Lbl}"/>
                    <Slider Minimum="1" Maximum="100" Value="{Binding Draft.VideoQuality}"/>
                    <TextBlock Text="Encoder preference" Style="{StaticResource Lbl}"/>
                    <ComboBox ItemsSource="{Binding Encoders}" SelectedItem="{Binding Draft.EncoderPreference}"/>
                    <TextBlock Text="Default export folder (blank = default)" Style="{StaticResource Lbl}"/>
                    <TextBox Text="{Binding Draft.ExportFolder}"/>
                </StackPanel></Border>

                <TextBlock Text="Interface" Style="{StaticResource H2}"/>
                <Border Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Text="Theme" Style="{StaticResource Lbl}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Draft.Theme}"/>
                    <TextBlock Text="Accent colour" Style="{StaticResource Lbl}"/>
                    <ItemsControl ItemsSource="{Binding Accents}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Width="28" Height="28" Padding="0" Margin="0,0,8,0" Background="{Binding}"
                                    Command="{Binding DataContext.SetAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="UI scale" Style="{StaticResource Lbl}"/>
                    <Slider Minimum="0.8" Maximum="1.5" Value="{Binding Draft.UiScale}"/>
                    <CheckBox Content="Enable interface animations" IsChecked="{Binding Draft.AnimationsEnabled}" Margin="0,10,0,0"/>
                </StackPanel></Border>

                <TextBlock Text="Storage" Style="{StaticResource H2}"/>
                <Border Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Text="Project directory (blank = default)" Style="{StaticResource Lbl}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Draft.ProjectDirectory}"/>
                    <TextBlock Text="Preset directory (blank = default)" Style="{StaticResource Lbl}"/>
                    <TextBox Text="{Binding Draft.PresetDirectory}"/>
                    <TextBlock Text="Temporary file directory (blank = default)" Style="{StaticResource Lbl}"/>
                    <TextBox Text="{Binding Draft.TempDirectory}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Clear cache" Command="{Binding ClearCacheCommand}"/>
                        <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding CacheInfo}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                </StackPanel></Border>
                <Border Height="16"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
