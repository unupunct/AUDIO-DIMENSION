<UserControl x:Class="AudioDimension.App.Views.TextInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AudioDimension.App.Controls"
             x:Name="root">
    <UserControl.Resources>
        <Style x:Key="Sec" TargetType="TextBlock" BasedOn="{StaticResource H2}">
            <Setter Property="Margin" Value="0,16,0,6"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Tiny" TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,6,0,3"/></Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,12">
            <TextBlock Text="Text layer" Style="{StaticResource H2}" Margin="0,0,0,2"/>
            <TextBlock Text="Select or add a layer to edit it." TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel DataContext="{Binding SelectedLayer}">
                <TextBlock Text="CONTENT" Style="{StaticResource Sec}"/>
                <ComboBox ItemsSource="{Binding DataContext.Kinds, ElementName=root}" SelectedItem="{Binding Kind}" AutomationProperties.Name="Layer kind"/>
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="140" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Layer text"/>

                <TextBlock Text="FONT" Style="{StaticResource Sec}"/>
                <ComboBox ItemsSource="{Binding DataContext.Fonts, ElementName=root}" SelectedItem="{Binding FontFamily}" IsEditable="False" AutomationProperties.Name="Font family"/>
                <c:ParamSlider Label="Size" Unit="px" Minimum="8" Maximum="320" Value="{Binding FontSize, Mode=TwoWay}"/>
                <DockPanel Margin="0,0,0,8">
                    <ComboBox DockPanel.Dock="Right" Width="90" ItemsSource="{Binding DataContext.Weights, ElementName=root}" SelectedItem="{Binding FontWeight}" AutomationProperties.Name="Font weight"/>
                    <CheckBox Content="Italic" IsChecked="{Binding Italic}" VerticalAlignment="Center"/>
                </DockPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Right" Width="26" Height="26" CornerRadius="13" BorderBrush="#66FFFFFF" BorderThickness="1" Margin="8,0,0,0" Background="{Binding Color}"/>
                    <TextBox Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Text colour"/>
                </DockPanel>
                <c:ParamSlider Label="Opacity" Minimum="0" Maximum="1" Value="{Binding Opacity, Mode=TwoWay}"/>
                <ComboBox ItemsSource="{Binding DataContext.Aligns, ElementName=root}" SelectedItem="{Binding Align}" AutomationProperties.Name="Alignment"/>
                <c:ParamSlider Label="Letter spacing" Unit="px" Minimum="-10" Maximum="80" Value="{Binding LetterSpacing, Mode=TwoWay}"/>
                <c:ParamSlider Label="Line spacing" Unit="x" Minimum="0.6" Maximum="3" Value="{Binding LineSpacing, Mode=TwoWay}"/>

                <TextBlock Text="POSITION" Style="{StaticResource Sec}"/>
                <c:ParamSlider Label="X (0 = left edge, 1 = right edge)" Minimum="-0.2" Maximum="1.2" Value="{Binding X, Mode=TwoWay}"/>
                <c:ParamSlider Label="Y (0 = top, 1 = bottom)" Minimum="-0.2" Maximum="1.2" Value="{Binding Y, Mode=TwoWay}"/>
                <c:ParamSlider Label="Rotation" Unit="deg" Minimum="-180" Maximum="180" Value="{Binding Rotation, Mode=TwoWay}"/>
                <c:ParamSlider Label="Scale" Unit="x" Minimum="0.2" Maximum="4" Value="{Binding Scale, Mode=TwoWay}"/>
                <TextBlock Text="Alignment presets" Style="{StaticResource Tiny}"/>
                <UniformGrid Columns="3" Width="150" HorizontalAlignment="Left">
                    <Button Content="&#x2196;" ToolTip="Top left" Command="{Binding DataContext.AlignToCommand, ElementName=root}" CommandParameter="TL" Margin="2" Padding="0,6" AutomationProperties.Name="Align top left"/>
                    <Button Content="&#x2191;" ToolTip="Top centre" Command="{Binding DataContext.AlignToCommand, ElementName=root}" CommandParameter="TC" Margin="2" Padding="0,6" AutomationProperties.Name="Align top centre"/>
                    <Button Content="&#x2197;" ToolTip="Top right" Command="{Binding DataContext.AlignToCommand, ElementName=root}" CommandParameter="TR" Margin="2" Padding="0,6" AutomationProperties.Name="Align top right"/>
                    <Button Content="&#x2190;" ToolTip="Middle left" Command="{Binding DataContext.AlignToCommand, ElementName=root}" CommandParameter="ML" Margin="2" Padding="0,6" AutomationProperties.Name="Align middle left"/>
                    <Button Content="&#x25CF;" ToolTip="Centre" Command="{Binding DataContext.AlignToCommand, ElementName=root}" CommandParameter="MC" Margin="2" Padding="0,6" AutomationProperties.Name="Align centre"/>
                    <Button Content="&#x2192;" ToolTip="Middle right" Command="{Binding DataContext.AlignToCommand, ElementName=root}" CommandParameter="MR" Margin="2" Padding="0,6" AutomationProperties.Name="Align middle right"/>
                    <Button Content="&#x2199;" ToolTip="Bottom left" Command="{Binding DataContext.AlignToCommand, ElementName=root}" CommandParameter="BL" Margin="2" Padding="0,6" AutomationProperties.Name="Align bottom left"/>
                    <Button Content="&#x2193;" ToolTip="Bottom centre" Command="{Binding DataContext.AlignToCommand, ElementName=root}" CommandParameter="BC" Margin="2" Padding="0,6" AutomationProperties.Name="Align bottom centre"/>
                    <Button Content="&#x2198;" ToolTip="Bottom right" Command="{Binding DataContext.AlignToCommand, ElementName=root}" CommandParameter="BR" Margin="2" Padding="0,6" AutomationProperties.Name="Align bottom right"/>
                </UniformGrid>

                <TextBlock Text="SHADOW" Style="{StaticResource Sec}"/>
                <CheckBox Content="Drop shadow" IsChecked="{Binding Shadow.Enabled}"/>
                <TextBox Text="{Binding Shadow.Color, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                <c:ParamSlider Label="Opacity" Minimum="0" Maximum="1" Value="{Binding Shadow.Opacity, Mode=TwoWay}"/>
                <c:ParamSlider Label="Blur" Unit="px" Minimum="0" Maximum="40" Value="{Binding Shadow.Blur, Mode=TwoWay}"/>
                <c:ParamSlider Label="Offset X" Unit="px" Minimum="-40" Maximum="40" Value="{Binding Shadow.OffsetX, Mode=TwoWay}"/>
                <c:ParamSlider Label="Offset Y" Unit="px" Minimum="-40" Maximum="40" Value="{Binding Shadow.OffsetY, Mode=TwoWay}"/>

                <TextBlock Text="OUTLINE" Style="{StaticResource Sec}"/>
                <CheckBox Content="Outline" IsChecked="{Binding Outline.Enabled}"/>
                <TextBox Text="{Binding Outline.Color, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                <c:ParamSlider Label="Width" Unit="px" Minimum="0.5" Maximum="16" Value="{Binding Outline.Width, Mode=TwoWay}"/>

                <TextBlock Text="GLOW" Style="{StaticResource Sec}"/>
                <CheckBox Content="Glow" IsChecked="{Binding Glow.Enabled}"/>
                <TextBox Text="{Binding Glow.Color, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                <c:ParamSlider Label="Radius" Unit="px" Minimum="1" Maximum="80" Value="{Binding Glow.Radius, Mode=TwoWay}"/>
                <c:ParamSlider Label="Intensity" Minimum="0.2" Maximum="3" Value="{Binding Glow.Intensity, Mode=TwoWay}"/>

                <TextBlock Text="BACKGROUND PANEL, BORDER, PADDING" Style="{StaticResource Sec}"/>
                <CheckBox Content="Background panel" IsChecked="{Binding Panel.Enabled}"/>
                <TextBox Text="{Binding Panel.Color, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                <c:ParamSlider Label="Panel opacity" Minimum="0" Maximum="1" Value="{Binding Panel.Opacity, Mode=TwoWay}"/>
                <c:ParamSlider Label="Corner radius" Unit="px" Minimum="0" Maximum="80" Value="{Binding Panel.CornerRadius, Mode=TwoWay}"/>
                <CheckBox Content="Border" IsChecked="{Binding Border.Enabled}"/>
                <TextBox Text="{Binding Border.Color, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                <c:ParamSlider Label="Border width" Unit="px" Minimum="0.5" Maximum="16" Value="{Binding Border.Width, Mode=TwoWay}"/>
                <c:ParamSlider Label="Padding" Unit="px" Minimum="0" Maximum="120" Value="{Binding Padding, Mode=TwoWay}"/>

                <TextBlock Text="TIMELINE" Style="{StaticResource Sec}"/>
                <c:ParamSlider Label="Start time" Unit="s" Minimum="0" Maximum="60" Value="{Binding StartTime, Mode=TwoWay}"/>
                <c:ParamSlider Label="End time (0 = until the end)" Unit="s" Minimum="0" Maximum="120" Value="{Binding EndTime, Mode=TwoWay}"/>

                <TextBlock Text="ANIMATIONS" Style="{StaticResource Sec}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Add" Command="{Binding DataContext.AddAnimationCommand, ElementName=root}" Margin="6,0,0,0" Padding="14,6" AutomationProperties.Name="Add animation"/>
                    <ComboBox ItemsSource="{Binding DataContext.AnimTypes, ElementName=root}" SelectedItem="{Binding DataContext.NewAnimation, ElementName=root}" AutomationProperties.Name="Animation type"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Animations}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Remove" Padding="8,3" Command="{Binding DataContext.RemoveAnimationCommand, ElementName=root}" CommandParameter="{Binding}"/>
                                        <ComboBox ItemsSource="{Binding DataContext.AnimTypes, ElementName=root}" SelectedItem="{Binding Type}" Margin="0,0,8,0"/>
                                    </DockPanel>
                                    <c:ParamSlider Label="Duration" Unit="s" Minimum="0.1" Maximum="12" Value="{Binding Duration, Mode=TwoWay}"/>
                                    <c:ParamSlider Label="Delay" Unit="s" Minimum="0" Maximum="20" Value="{Binding Delay, Mode=TwoWay}"/>
                                    <c:ParamSlider Label="Strength" Unit="x" Minimum="0.1" Maximum="3" Value="{Binding Amount, Mode=TwoWay}"/>
                                    <UniformGrid Columns="2">
                                        <ComboBox ItemsSource="{Binding DataContext.Easings, ElementName=root}" SelectedItem="{Binding Easing}" Margin="0,0,4,0" ToolTip="Easing"/>
                                        <ComboBox ItemsSource="{Binding DataContext.Directions, ElementName=root}" SelectedItem="{Binding Direction}" Margin="4,0,0,0" ToolTip="Direction"/>
                                    </UniformGrid>
                                    <CheckBox Content="Loop" IsChecked="{Binding Loop}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
