<UserControl x:Class="AudioDimension.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Dashboard" Style="{StaticResource H1}"/>
        <UniformGrid Columns="3" Margin="0,18,0,0">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel>
                <TextBlock Text="{Binding ProjectCount}" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Projects" Style="{StaticResource Muted}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="4,0"><StackPanel>
                <TextBlock Text="{Binding CustomPresetCount}" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Saved presets" Style="{StaticResource Muted}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel>
                <TextBlock Text="{Binding ExportCount}" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Exports" Style="{StaticResource Muted}"/></StackPanel></Border>
        </UniformGrid>
        <TextBlock Text="System" Style="{StaticResource H2}"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{Binding Runtime}"/>
                <TextBlock Text="{Binding DataFolder, StringFormat=Data: {0}}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding DatabaseFile, StringFormat=Database: {0}}" Style="{StaticResource Muted}"/>
                <TextBlock Text="{Binding LogFolder, StringFormat=Logs: {0}}" Style="{StaticResource Muted}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
