<UserControl x:Class="AudioDimension.App.Views.PresetLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AudioDimension.App.Controls">
    <UserControl.Resources>
        <Style x:Key="Tiny" TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="FontSize" Value="11"/></Style>
        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Width="190" CornerRadius="12" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2" Padding="4,4,4,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#55FFFFFF"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseDoubleClick" Handler="OnCardDoubleClick"/>
        </Style>
        <Style x:Key="StarToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="#99000000" CornerRadius="12" Width="26" Height="26">
                            <TextBlock x:Name="t" Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="t" Property="Text" Value="&#xE735;"/><Setter TargetName="t" Property="Foreground" Value="#FFD54F"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChipToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" CornerRadius="8" Padding="12,7" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="b" Property="Background" Value="#22FFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>

        <!-- Browser -->
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Preset Library" Style="{StaticResource H1}"/>
            <WrapPanel DockPanel.Dock="Top" Margin="0,12,0,12">
                <StackPanel Width="230" Margin="0,0,10,6"><TextBlock Text="Search by name" Style="{StaticResource Tiny}"/>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search presets"/></StackPanel>
                <StackPanel Width="170" Margin="0,0,10,6"><TextBlock Text="Category" Style="{StaticResource Tiny}"/>
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"/></StackPanel>
                <StackPanel Width="140" Margin="0,0,10,6"><TextBlock Text="Sort by" Style="{StaticResource Tiny}"/>
                    <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <ToggleButton Style="{StaticResource ChipToggle}" IsChecked="{Binding FavoritesOnly}" Content="&#x2605; Favorites"/>
                    <ToggleButton Style="{StaticResource ChipToggle}" IsChecked="{Binding CustomOnly}" Content="Custom"/>
                    <Button Content="Clear" Command="{Binding ClearFiltersCommand}" Margin="0,0,16,0"/>
                    <Button Content="Import..." Command="{Binding ImportCommand}" Margin="0,0,8,0"/>
                    <Button Content="Export custom..." Command="{Binding ExportCustomCommand}"/>
                </StackPanel>
            </WrapPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding CountText}" Style="{StaticResource Muted}" Margin="2,6,0,0"/>
            <ListBox ItemsSource="{Binding Cards}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource CardItem}"
                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Presets">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Grid>
                                <Border CornerRadius="9" ClipToBounds="True" Height="100" Background="#0A0B0E">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                </Border>
                                <ToggleButton Style="{StaticResource StarToggle}" IsChecked="{Binding IsFavorite}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" ToolTip="Favourite"/>
                            </Grid>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="6,8,6,0" TextTrimming="CharacterEllipsis"/>
                            <DockPanel Margin="6,2,6,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Source}" Style="{StaticResource Tiny}"/>
                                <TextBlock Text="{Binding Category}" Style="{StaticResource Tiny}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Preview + details -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <UniformGrid Columns="2">
                        <Button Content="Use this preset" Style="{StaticResource AccentButton}" Command="{Binding ApplyToStudioCommand}" Margin="0,0,6,6" AutomationProperties.Name="Use this preset"/>
                        <Button Content="Duplicate" Command="{Binding DuplicateCommand}" Margin="6,0,0,6"/>
                        <Button Content="Export..." Command="{Binding ExportCommand}" Margin="0,0,6,0"/>
                        <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="6,0,0,0" IsEnabled="{Binding CanEdit}"/>
                    </UniformGrid>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Selected}">
                        <Border CornerRadius="10" ClipToBounds="True" Background="#0A0B0E" Height="190" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <c:GlPreview DataContext="{Binding PreviewStudio}"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" DataContext="{Binding DataContext.PreviewStudio, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Button Command="{Binding PlayCommand}" Padding="12,6" AutomationProperties.Name="Preview with live audio"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Preview with live audio" Margin="7,0,0,0"/></StackPanel></Button>
                            <Button Command="{Binding StopCommand}" Padding="12,6" Margin="6,0,0,0" Content="Stop"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" Margin="0,14,0,2"/>
                        <TextBlock Text="{Binding Category}" Foreground="{StaticResource AccentBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="Look" Style="{StaticResource Tiny}" Margin="0,12,0,4"/>
                        <ItemsControl ItemsSource="{Binding Colors}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Border Width="26" Height="26" CornerRadius="13" Margin="0,0,6,0" Background="{Binding}" BorderBrush="#44FFFFFF" BorderThickness="1"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding VisualizerName, StringFormat=Engine: {0}}" Style="{StaticResource Tiny}" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding Customizable, StringFormat=Customizable: {0}}" Style="{StaticResource Tiny}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <StackPanel Margin="0,14,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <TextBlock Text="Rename (custom presets)" Style="{StaticResource Tiny}"/>
                            <DockPanel Margin="0,3,0,0">
                                <Button DockPanel.Dock="Right" Content="Rename" Command="{Binding RenameCommand}" IsEnabled="{Binding CanEdit}" Margin="6,0,0,0" Padding="10,6"/>
                                <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}"/>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
