<UserControl x:Class="AudioDimension.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Text="About" Style="{StaticResource H1}"/>
        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Text="Audio Dimension" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Version, StringFormat=Version {0}}" Style="{StaticResource Muted}"/>
                <TextBlock Text="{Binding Privacy}" TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
