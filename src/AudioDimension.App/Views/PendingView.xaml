<UserControl x:Class="AudioDimension.App.Views.PendingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>
        <Border Style="{StaticResource Card}" Margin="0,18,0,0" HorizontalAlignment="Left" MaxWidth="560">
            <StackPanel>
                <TextBlock Text="Not built yet" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,6,0,0" Style="{StaticResource Muted}"/>
                <TextBlock Text="{Binding Stage, StringFormat=Planned for {0} of the roadmap.}" Margin="0,10,0,0" Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
