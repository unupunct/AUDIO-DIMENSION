<UserControl x:Class="AudioDimension.App.Views.TextEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AudioDimension.App.Controls">
    <UserControl.Resources>
        <Style x:Key="Tiny" TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,10,0,4"/></Style>
        <Style x:Key="LayerItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,0,0,3" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#18FFFFFF"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource CardBrush}"/><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- Layers + templates -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Text &amp; Titles" Style="{StaticResource H1}"/>
                <TextBlock Text="Add layer" Style="{StaticResource Tiny}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddLayerCommand}" Margin="6,0,0,0" Padding="14,6" Style="{StaticResource AccentButton}" AutomationProperties.Name="Add text layer"/>
                    <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding NewKind}" AutomationProperties.Name="Layer type"/>
                </DockPanel>
                <TextBlock Text="Layers (top of list draws first)" Style="{StaticResource Tiny}"/>
                <ListBox ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}" ItemContainerStyle="{StaticResource LayerItem}" MinHeight="120" MaxHeight="260"
                         Background="Transparent" BorderThickness="0" AutomationProperties.Name="Text layers">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Visible}" ToolTip="Show / hide" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Margin="0,6,0,0">
                    <Button Content="Duplicate" Command="{Binding DuplicateLayerCommand}" Padding="10,5" Margin="0,0,6,6"/>
                    <Button Content="Delete" Command="{Binding DeleteLayerCommand}" Padding="10,5" Margin="0,0,6,6"/>
                    <Button Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" ToolTip="Move up" AutomationProperties.Name="Move layer up" Command="{Binding MoveLayerUpCommand}" Padding="10,5" Margin="0,0,6,6"/>
                    <Button Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" ToolTip="Move down" AutomationProperties.Name="Move layer down" Command="{Binding MoveLayerDownCommand}" Padding="10,5" Margin="0,0,6,6"/>
                    <Button Content="Clear all" Command="{Binding ClearLayersCommand}" Padding="10,5" Margin="0,0,0,6"/>
                </WrapPanel>

                <TextBlock Text="TITLE TEMPLATES" Style="{StaticResource H2}" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" AutomationProperties.Name="Title template"/>
                <TextBlock Text="{Binding SelectedTemplate.Description}" Style="{StaticResource Tiny}" TextWrapping="Wrap"/>
                <WrapPanel Margin="0,4,0,0">
                    <Button Content="Apply (replace)" Command="{Binding ApplyTemplateCommand}" Padding="10,5" Margin="0,0,6,6" AutomationProperties.Name="Apply template"/>
                    <Button Content="Add to layers" Command="{Binding AddTemplateCommand}" Padding="10,5" Margin="0,0,6,6"/>
                </WrapPanel>
                <TextBlock Text="Save current layers as a template" Style="{StaticResource Tiny}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Save" Command="{Binding SaveTemplateCommand}" Margin="6,0,0,0" Padding="12,6" AutomationProperties.Name="Save template"/>
                    <TextBox Text="{Binding NewTemplateName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Template name"/>
                </DockPanel>
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Import..." Command="{Binding ImportTemplateCommand}" Padding="10,5" Margin="0,0,6,6"/>
                    <Button Content="Export..." Command="{Binding ExportTemplateCommand}" Padding="10,5" Margin="0,0,6,6"/>
                    <Button Content="Delete template" Command="{Binding DeleteTemplateCommand}" IsEnabled="{Binding CanDeleteTemplate}" Padding="10,5" Margin="0,0,0,6"/>
                </WrapPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Preview + timeline -->
        <Grid Grid.Column="2" DataContext="{Binding Studio}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,10">
                <Button Command="{Binding PlayCommand}" Padding="12,7" Margin="0,0,6,0" ToolTip="Start audio capture so the visualization reacts"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Audio on" Margin="7,0,0,0"/></StackPanel></Button>
                <Button Command="{Binding StopCommand}" Padding="12,7" Margin="0,0,14,0" Content="Audio off"/>
                <Button Command="{Binding RestartTimelineCommand}" Padding="12,7" Margin="0,0,6,0" AutomationProperties.Name="Restart text animations"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"/><TextBlock Text="Restart animations" Margin="7,0,0,0"/></StackPanel></Button>
                <CheckBox Content="Play timeline" IsChecked="{Binding TimelinePlaying}" VerticalAlignment="Center" Margin="8,0,14,0"/>
                <CheckBox Content="Snap to guides" IsChecked="{Binding SnapText}" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Snap to centre, thirds and safe margins while dragging"/>
                <CheckBox Content="Safe-area grid" IsChecked="{Binding ShowGrid}" VerticalAlignment="Center"/>
            </WrapPanel>
            <Border Grid.Row="1" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="#0A0B0E" ClipToBounds="True">
                <c:AspectPanel Ratio="{Binding SelectedAspect.Ratio}">
                    <Border ClipToBounds="True" CornerRadius="4"><c:GlPreview TextEdit="True" AutomationProperties.Name="Text editing preview"/></Border>
                </c:AspectPanel>
            </Border>
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding TextTime, StringFormat={}{0:0.00} s}" Style="{StaticResource Muted}" Width="64" TextAlignment="Right"/>
                    <TextBlock DockPanel.Dock="Left" Text="Timeline" Style="{StaticResource Muted}" Margin="0,0,10,0"/>
                    <Slider Minimum="0" Maximum="{Binding TextLoopSeconds}" Value="{Binding TextTime, Mode=TwoWay}" AutomationProperties.Name="Timeline position"/>
                </DockPanel>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding TextLoopSeconds, StringFormat='{}{0:0} s (0 = no loop)'}" Style="{StaticResource Muted}" Width="130" TextAlignment="Right"/>
                    <TextBlock DockPanel.Dock="Left" Text="Loop length" Style="{StaticResource Muted}" Margin="0,0,10,0"/>
                    <Slider Minimum="0" Maximum="60" Value="{Binding TextLoopSeconds, Mode=TwoWay}" AutomationProperties.Name="Timeline loop length"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Click text to select it, drag to move (it snaps to centre, thirds and margins), Ctrl+wheel to resize. Animations follow this timeline in the preview, screenshots and exports."/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
