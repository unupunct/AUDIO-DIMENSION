<UserControl x:Class="AudioDimension.App.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Tiny" TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,10,0,4"/></Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,12,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="560"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Projects" Style="{StaticResource H1}"/>
                <TextBlock Text="A project holds everything needed to reopen your work: the look, preset customisations, text layers, audio source, background picture, canvas size and recording choices." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                <WrapPanel Margin="0,16,0,0">
                    <Button Content="New" Command="{Binding NewProjectCommand}" Padding="16,8" Margin="0,0,8,8" ToolTip="Ctrl+N" AutomationProperties.Name="New project"/>
                    <Button Content="Open..." Command="{Binding OpenProjectCommand}" Padding="16,8" Margin="0,0,8,8" ToolTip="Ctrl+O" AutomationProperties.Name="Open project"/>
                    <Button Content="Save" Command="{Binding SaveCommand}" Padding="16,8" Margin="0,0,8,8" Style="{StaticResource AccentButton}" ToolTip="Ctrl+S" AutomationProperties.Name="Save project"/>
                    <Button Content="Save as..." Command="{Binding SaveAsCommand}" Padding="16,8" Margin="0,0,8,8" ToolTip="Ctrl+Shift+S" AutomationProperties.Name="Save project as"/>
                    <Button Content="Duplicate" Command="{Binding DuplicateCommand}" Padding="16,8" Margin="0,0,8,8" AutomationProperties.Name="Duplicate project"/>
                    <Button Content="Import..." Command="{Binding ImportCommand}" Padding="16,8" Margin="0,0,8,8" AutomationProperties.Name="Import project"/>
                    <Button Content="Export a copy..." Command="{Binding ExportCopyCommand}" Padding="16,8" Margin="0,0,8,8" AutomationProperties.Name="Export project copy"/>
                </WrapPanel>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,2,0,0" AutomationProperties.Name="Project status"/>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="Unsaved changes" Foreground="#F5C842" FontSize="11" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsDirty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Current project" Style="{StaticResource Muted}"/>
                    </DockPanel>
                    <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Margin="0,6,0,0" AutomationProperties.Name="Project name"/>
                    <TextBlock Text="{Binding PathText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"/>
                    <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource Muted}" FontSize="11"/>
                    <CheckBox Content="Store the current recording inside the project" IsChecked="{Binding IncludeRecording}" IsEnabled="{Binding HasRecording}" Margin="0,14,0,0"/>
                    <TextBlock Text="{Binding RecordingInfo}" Style="{StaticResource Muted}" FontSize="11" Margin="22,0,0,0"/>
                </StackPanel></Border>

                <Border Margin="0,12,0,0" BorderBrush="#F5C842">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding HasWarnings}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Needs attention" Foreground="#F5C842" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding Warnings}" AutomationProperties.Name="Project warnings">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,6,0,0"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="Embedded files" Style="{StaticResource H2}"/>
                <Border Style="{StaticResource Card}" Padding="10">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Assets}" AutomationProperties.Name="Project assets">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" Style="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding Kind}" Style="{StaticResource Muted}" Width="56"/>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Pictures and recordings are copied into the project, so it still works if the original files move." Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="0,10,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Clear list" Command="{Binding ClearRecentCommand}" Padding="10,4"/>
                    <TextBlock Text="Recent projects" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                </DockPanel>
                <Border Style="{StaticResource Card}" Padding="8">
                    <StackPanel>
                    <TextBlock Text="No projects yet. Save one and it will appear here." Margin="8,6">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding Recent.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Recent}" AutomationProperties.Name="Recent projects">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="6,6">
                                    <Button DockPanel.Dock="Right" Content="Remove" Padding="8,3" Margin="6,0,0,0" Command="{Binding DataContext.RemoveRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                    <Button DockPanel.Dock="Right" Content="Open" Padding="12,3" IsEnabled="{Binding Exists}" Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                        <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="{Binding OpenedUtc, StringFormat=Opened {0:g}}"/>
                                        <TextBlock Text="File not found - it was moved or deleted" Foreground="{StaticResource DangerBrush}" FontSize="11">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding Exists}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </Border>
                <Button Content="Open projects folder" Command="{Binding OpenFolderCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="12,6"/>
                <TextBlock Text="Projects are saved as .adproj files (a zip containing project.json and your embedded files), so they can be copied, emailed or backed up like any file. The format is documented in docs/PROJECT_FORMAT.md." Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
